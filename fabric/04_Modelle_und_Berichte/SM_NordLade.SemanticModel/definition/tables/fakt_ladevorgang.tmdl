table fakt_ladevorgang
	lineageTag: 50047ae3-5980-4615-8b4f-d1349b1a059c
	sourceLineageTag: [gold].[fakt_ladevorgang]

	measure Umsatz = SUM ( fakt_ladevorgang[umsatz_eur] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b92117aa-a7d6-49df-b52b-3495f26a6b49

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Energie kWh' = SUM ( fakt_ladevorgang[energie_kwh] )
		formatString: #,0
		lineageTag: d9fa0bd5-d9d2-4cd5-9e30-323295e1ee7d

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure Ladevorgänge = COUNTROWS ( fakt_ladevorgang )
		formatString: 0
		lineageTag: b3936831-78e5-4a1a-80d6-11a345f6ac44

		changedProperty = Name

	measure Marge = SUM ( fakt_ladevorgang[marge_eur] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 7df4311d-e0f9-4e6c-b963-e8701bccd2a2

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Marge %' = DIVIDE ( [Marge], [Umsatz] )
		lineageTag: 3a2ae663-9565-413a-8107-854352dcb15f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ø Dauer Min' = AVERAGE ( fakt_ladevorgang[dauer_minuten] )
		lineageTag: efe58864-e992-462c-bb0a-26f820c3c3eb

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ø Preis je kWh' = DIVIDE ( [Umsatz], [Energie kWh] )
		lineageTag: c6b425f8-2e9b-4005-b94d-dd263e5392de

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Umsatz Vormonat' = CALCULATE ( [Umsatz], DATEADD ( dim_datum[datum], -1, MONTH ) )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: cff42092-bd72-48b8-bc24-db5be01b8ac2

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Umsatz ggü. Vormonat %' = DIVIDE ( [Umsatz] - [Umsatz Vormonat], [Umsatz Vormonat] )
		lineageTag: 573ed214-6460-4719-9190-c7c27757ce89

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

